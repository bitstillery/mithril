{
    "name": "@bitstillery/mithril",
    "version": "3.11.3",
    "description": "Mithril + Signals, Store and SSR",
    "license": "MIT",
    "author": "Bitstillery",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bitstillery/mithril.git"
    },
    "files": [
        "src",
        "LICENSE",
        "README.md"
    ],
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./server": {
            "import": "./src/server.ts",
            "default": "./src/server.ts"
        },
        "./htm": {
            "import": "./src/htm.ts",
            "default": "./src/htm.ts"
        },
        "./router": {
            "import": "./src/router/index.ts",
            "default": "./src/router/index.ts"
        },
        "./ssr-context": {
            "import": "./src/ssr/context.ts",
            "default": "./src/ssr/context.ts"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "lint": "bun run lint:ts",
        "lint:ts": "bun run lint:ts-format && bun run lint:ts-syntax && bun run lint:ts-types",
        "lint:ts-format": "oxfmt",
        "lint:ts-syntax": "oxlint -c .oxlintrc.json",
        "lint:ts-types": "tsc --noEmit",
        "lint:examples": "tsc --noEmit -p examples/ssr && tsc --noEmit -p examples/state",
        "test": "bun test",
        "bench": "NODE_ENV=production bun run bench/index.ts",
        "bench:hyperscript": "NODE_ENV=production bun run bench/index.ts hyperscript",
        "bench:render": "NODE_ENV=production bun run bench/index.ts render",
        "bench:signal": "NODE_ENV=production bun run bench/index.ts signal",
        "bench:state": "NODE_ENV=production bun run bench/index.ts state",
        "bench:profile": "bun --cpu-prof-md run bench/index.ts",
        "prepublishOnly": "oxfmt --check && bun run lint:ts-syntax && bun run lint:ts-types",
        "pack:dry-run": "npm pack --dry-run",
        "release": "./scripts/release.sh",
        "release:patch": "./scripts/release.sh --release-as patch",
        "release:minor": "./scripts/release.sh --release-as minor",
        "release:major": "./scripts/release.sh --release-as major"
    },
    "dependencies": {
        "htm": "^3.1.1"
    },
    "devDependencies": {
        "@codemirror/lang-html": "^6.4.9",
        "@codemirror/lang-javascript": "^6.2.2",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/state": "^6.4.1",
        "@codemirror/theme-one-dark": "^6.1.2",
        "@codemirror/view": "^6.39.1",
        "@types/bun": "^1.3.9",
        "codemirror": "^6.0.1",
        "marked": "^15.0.4",
        "marked-gfm-heading-id": "^4.0.0",
        "mitata": "^1.0.34",
        "oxfmt": "^0.32.0",
        "oxlint": "^1.74.0",
        "oxlint-tsgolint": "^7.0.2003",
        "standard-version": "^9.5.0",
        "tippy.js": "^6.3.7",
        "typescript": "^7.0.2"
    }
}
